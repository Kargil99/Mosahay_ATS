# For production, point the browser to /api/v1 and set API_PROXY_ORIGIN to the API service host.
# The Next.js rewrite keeps browser requests, session cookies, uploads, and OAuth callbacks on the app origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PROXY_ORIGIN=
